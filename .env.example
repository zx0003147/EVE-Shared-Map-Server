# Copy this file to .env. These are local-development examples only.
SHARED_MAP_DEV_DATABASE_NAME=eve_shared_map
SHARED_MAP_DEV_DATABASE_USER=eve_shared_map
SHARED_MAP_DEV_DATABASE_PASSWORD_FILE=./.secrets/dev-db-password.txt
SHARED_MAP_DEV_TOKEN_PEPPER_FILE=./.secrets/dev-token-pepper.txt
# Comma-separated exact browser origins. Remote origins must use HTTPS; no wildcard is accepted.
SHARED_MAP_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
