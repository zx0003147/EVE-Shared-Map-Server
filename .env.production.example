# Copy to .env.production on the VPS. Values here are placeholders, never production secrets.
SHARED_MAP_DOMAIN=markers.example.com
SHARED_MAP_WEB_DOMAIN=map.example.com
SHARED_MAP_ACME_EMAIL=admin@example.com
SHARED_MAP_HTTP_PORT=80
SHARED_MAP_HTTPS_PORT=443
# Exact HTTPS origin serving the Web client. Use commas for multiple approved origins.
SHARED_MAP_ALLOWED_ORIGINS=https://map.example.com

# Pin immutable release tags. Production must never deploy :latest.
SHARED_MAP_SERVER_IMAGE=ghcr.io/zx0003147/eve-shared-map-server:0.2.0
SHARED_MAP_OPS_IMAGE=ghcr.io/zx0003147/eve-shared-map-ops:0.2.0
SHARED_MAP_POSTGRES_IMAGE=postgres:18.6-alpine
SHARED_MAP_CADDY_IMAGE=caddy:2.10.2-alpine

SHARED_MAP_DATABASE_NAME=eve_shared_map
SHARED_MAP_POSTGRES_DATABASE_USER_FILE=/opt/eve-shared-map/secrets/postgres-database-user.txt
SHARED_MAP_POSTGRES_DATABASE_PASSWORD_FILE=/opt/eve-shared-map/secrets/postgres-database-password.txt
SHARED_MAP_SERVER_DATABASE_USER_FILE=/opt/eve-shared-map/secrets/server-database-user.txt
SHARED_MAP_SERVER_DATABASE_PASSWORD_FILE=/opt/eve-shared-map/secrets/server-database-password.txt
SHARED_MAP_TOKEN_PEPPER_FILE=/opt/eve-shared-map/secrets/token-pepper.txt
SHARED_MAP_BACKUP_PASSPHRASE_FILE=/opt/eve-shared-map/secrets/backup-passphrase.txt

# The off-site path must be backed by storage outside this VPS. A second local directory is not off-site.
SHARED_MAP_BACKUP_STAGING_HOST_DIR=/opt/eve-shared-map/backups-local-staging
SHARED_MAP_BACKUP_OFFSITE_HOST_DIR=/mnt/eve-shared-map-offsite
SHARED_MAP_BACKUP_DAILY_RETENTION=30
SHARED_MAP_BACKUP_MONTHLY_RETENTION=12
SHARED_MAP_EXPECTED_FLYWAY_VERSION=4

SHARED_MAP_LOG_LEVEL=INFO
SHARED_MAP_SERVER_MEMORY_LIMIT=768m
SHARED_MAP_SERVER_CPU_LIMIT=1.0
SHARED_MAP_POSTGRES_MEMORY_LIMIT=768m
SHARED_MAP_POSTGRES_CPU_LIMIT=1.0
SHARED_MAP_CADDY_MEMORY_LIMIT=256m
SHARED_MAP_CADDY_CPU_LIMIT=0.5
SHARED_MAP_OPS_MEMORY_LIMIT=512m
SHARED_MAP_OPS_CPU_LIMIT=1.0
